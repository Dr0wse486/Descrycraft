  "item.watchcraft.recon_drone.desc": "A recon drone you can deploy and pilot remotely; marks creatures in view",
  "item.watchcraft.customization_module.desc": "Unlocks the drone's module bay",
  "item.watchcraft.recon_boost_module.desc": "Widens and extends the drone's scanning cone; gates both the container marker and the alert radar",
  "item.watchcraft.container_marker_module.desc": "Marks nearby containers the drone can see, chests and barrels alike",
  "item.watchcraft.alert_radar_module.desc": "Warns of nearby creatures: monsters show orange, players show red",
  "item.watchcraft.signal_module_mk1.desc": "Adds 32 blocks of link range, so the drone can be flown farther out",
  "item.watchcraft.signal_module_mk2.desc": "A further 32 blocks on top of the first tier; both tiers together give 64",
  "item.watchcraft.speed_module.desc": "Removes the cruise governor: top speed becomes 1.5x a sprinting player, about 8.4 blocks/s",
  "item.watchcraft.attack_module.desc": "Lets the drone dive into a target or be blown by key, 125 damage within 3 blocks",
  "item.watchcraft.copper_battery.desc": "Fits the drone with 25% charge, about 12.5 minutes of flight",
  "item.watchcraft.graphite_electrode.desc": "Half of a graphite battery; the pack's recipe needs two",
  "item.watchcraft.graphite_battery.desc": "Fits the drone with a full 100% charge, about 50 minutes of flight",
